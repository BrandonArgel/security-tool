{
  "name": "ts-react",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.4",
  "scripts": {
    "dev": "next dev",
    "build": "bunx prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "bunx prisma generate",
    "push": "bunx prisma db push",
    "seed": "bunx tsx prisma/seed.ts",
    "studio": "bunx prisma studio",
    "migrate": "bunx prisma migrate dev",
    "db:generate": "bunx prisma generate",
    "db:push": "dotenv -e .env.local -- bunx prisma db push",
    "db:seed": "dotenv -e .env.local -- bunx tsx prisma/seed.ts",
    "db:studio": "dotenv -e .env.local -- bunx prisma studio",
    "migrate:dev": "dotenv -e .env.local -- bunx prisma migrate dev"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@hookform/resolvers": "^5.4.0",
    "@netlify/plugin-nextjs": "^5.15.12",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-radio-group": "^1.4.2",
    "@radix-ui/react-tooltip": "^1.2.11",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.23.0",
    "next": "16.2.10",
    "next-auth": "^5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.80.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.6.0",
    "eslint-config-next": "16.2.10",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
